NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arsipin?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_DAYS=14
FRONTEND_ORIGINS=http://localhost:3000
# Set COOKIE_SAME_SITE=none and COOKIE_SECURE=true when frontend/API are cross-site.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
